<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Phosphor</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\logo\phosphor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Phosphor.Core\Phosphor.Core.csproj" />
    <ProjectReference Include="..\Phosphor.Scenes\Phosphor.Scenes.csproj" />
    <ProjectReference Include="..\Phosphor.Gfx\Phosphor.Gfx.csproj" />
    <ProjectReference Include="..\Phosphor.Text\Phosphor.Text.csproj" />
    <ProjectReference Include="..\Phosphor.Filters\Phosphor.Filters.csproj" />
    <ProjectReference Include="..\Phosphor.Platform\Phosphor.Platform.csproj" />
    <ProjectReference Include="..\Phosphor.Audio\Phosphor.Audio.csproj" />
    <ProjectReference Include="..\Phosphor.Data\Phosphor.Data.csproj" />
    <ProjectReference Include="..\Phosphor.Overlays\Phosphor.Overlays.csproj" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>
  <!-- Изолированная сборка (OnlyScene/OnlyFilter/OnlyData): источники данных исключены из Phosphor.Data — без проводки к ним.
       DataWiring.cs ссылается на все источники, при OnlyData=<X> их нет, поэтому берём DataWiringIsolated.cs (без источников). -->
  <PropertyGroup>
    <_Isolated Condition="'$(OnlyData)$(OnlyScene)$(OnlyFilter)' != ''">true</_Isolated>
  </PropertyGroup>
  <ItemGroup Condition="'$(_Isolated)' == 'true'">
    <Compile Remove="DataWiring.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(_Isolated)' != 'true'">
    <Compile Remove="DataWiringIsolated.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\phosphor.json" Link="phosphor.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Встроенные шрифты (OFL) и их лицензии: в выходе — fonts\ рядом с exe (см. FontCatalog) -->
  <ItemGroup>
    <None Include="..\..\assets\fonts\**" Link="fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- Логотип для бирки (source=phosphor, BadgeLayer): в выходе — logo\phosphor.png рядом с exe, как fonts\ -->
  <ItemGroup>
    <None Include="..\..\assets\logo\phosphor.png" Link="logo\phosphor.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
