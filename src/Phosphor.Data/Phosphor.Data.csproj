<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Phosphor.Core\Phosphor.Core.csproj" />
    <!-- Только для разбора крошечных GIF мозаики SVT Text (Windows-only, как и весь проект). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
  <!-- Изоляция: -p:OnlyData=News компилирует только общие файлы + Sources\NewsSource.cs
       + Sources\NewsCatalog.cs (если есть) + Sources\CalmFilter.cs (нужен новостям). -->
  <ItemGroup Condition="'$(OnlyData)' != ''">
    <_Keep Include="IDataSource.cs;DataHub.cs;Common\**\*.cs;Sources\$(OnlyData)Source.cs" />
    <_Keep Condition="Exists('Sources\$(OnlyData)Catalog.cs')" Include="Sources\$(OnlyData)Catalog.cs" />
    <_Keep Condition="'$(OnlyData.ToLowerInvariant())' == 'news'" Include="Sources\CalmFilter.cs" />
    <Compile Remove="**\*.cs" />
    <Compile Include="@(_Keep->Distinct())" />
  </ItemGroup>
  <!-- Изолированная сборка сцены/фильтра: источники данных не нужны и могут быть недописаны другими — без них. -->
  <ItemGroup Condition="'$(OnlyData)' == '' and ('$(OnlyScene)' != '' or '$(OnlyFilter)' != '')">
    <Compile Remove="Sources\**\*.cs" />
  </ItemGroup>
</Project>
