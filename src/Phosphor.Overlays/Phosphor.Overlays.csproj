<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Phosphor.Core\Phosphor.Core.csproj" />
  </ItemGroup>
  <!-- Изолированная сборка сцены/фильтра: оверлеи могут быть недописаны другими. Но OSD видика (VcrOverlay, VcrState,
       OsdGeometry) использует приложение всегда (MonitorSlot/OsdLayer), поэтому они остаются; HUD — исключается. -->
  <ItemGroup Condition="'$(OnlyOverlay)' == '' and ('$(OnlyScene)' != '' or '$(OnlyFilter)' != '')">
    <_Keep Include="VcrOverlay.cs;VcrState.cs;OsdGeometry.cs" />
    <Compile Remove="**\*.cs" />
    <Compile Include="@(_Keep->Distinct())" />
  </ItemGroup>
</Project>
