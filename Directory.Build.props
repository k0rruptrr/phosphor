<Project>
  <!-- Общие настройки для всех проектов PHOSPHOR -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Обычная сборка (без AgentId, например dotnet publish) кладёт obj/bin внутрь проекта; сборки с AgentId
         не должны затягивать оттуда сгенерированные AssemblyInfo.cs как исходники. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <Version>0.8.3</Version>
  </PropertyGroup>
  <!-- Дата сборки — для строки версии в логе (AppInfo.BuildDate) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Параллельные агенты: dotnet build -p:AgentId=X собирает в свои bin/obj и не мешает остальным -->
  <PropertyGroup Condition="'$(AgentId)' != ''">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).build\$(AgentId)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory).build\$(AgentId)\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
